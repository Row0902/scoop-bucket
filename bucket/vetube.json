{
    "version": "3.96",
    "description": "Lee y gestiona de manera accesible el chat de tus directos o en los de tus creadores favoritos.",
    "homepage": "https://github.com/metalalchemist/VeTube",
    "license": "GPL-3.0",
    "notes": [
        "VeTube trae su propio actualizador (canal stable/beta en data.json). Con Scoop, actualiza con 'scoop update vetube'.",
        "Si prefieres que se actualice solo desde la app, ejecuta 'scoop hold vetube'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/metalalchemist/VeTube/releases/download/v3.96/vetube-v3.96.zip",
            "hash": "eed0648927e1d896c0d1b27408c351500e27b956272db5b0c33350c5bd6a3f91"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$dir\\data.json\")) { Set-Content \"$dir\\data.json\" '{}' }",
        "if (!(Test-Path \"$dir\\favoritos.json\")) { Set-Content \"$dir\\favoritos.json\" '[]' }",
        "if (!(Test-Path \"$dir\\mensajes_destacados.json\")) { Set-Content \"$dir\\mensajes_destacados.json\" '[]' }",
        "if (!(Test-Path \"$dir\\voices\")) { New-Item -ItemType Directory -Path \"$dir\\voices\" | Out-Null }",
        "if (!(Test-Path \"$dir\\engines\")) { New-Item -ItemType Directory -Path \"$dir\\engines\" | Out-Null }"
    ],
    "bin": [
        [
            "VeTube.exe",
            "vetube"
        ]
    ],
    "shortcuts": [
        [
            "VeTube.exe",
            "VeTube"
        ]
    ],
    "persist": [
        "data.json",
        "favoritos.json",
        "mensajes_destacados.json",
        "voices",
        "engines"
    ],
    "checkver": {
        "github": "https://github.com/metalalchemist/VeTube"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/metalalchemist/VeTube/releases/download/v$version/vetube-v$version.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
