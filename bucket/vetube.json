{
    "version": "3.91",
    "description": "Lee y gestiona de manera accesible el chat de tus directos o en los de tus creadores favoritos.",
    "homepage": "https://github.com/metalalchemist/VeTube",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/metalalchemist/VeTube/releases/download/v3.91/VeTube-x64.zip",
            "hash": "c488106f9937dea082cfda7f5520265af44905f688e6a4bc4798d54ef982901c"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$dir\\data.json\")) { Set-Content \"$dir\\data.json\" '{}' }",
        "if (!(Test-Path \"$dir\\keymaps\")) { New-Item -ItemType Directory -Path \"$dir\\keymaps\" | Out-Null }",
        "if (!(Test-Path \"$dir\\sounds\")) { New-Item -ItemType Directory -Path \"$dir\\sounds\" | Out-Null }"
    ],
    "bin": [
        [
            "run_main_window.exe",
            "vetube",
            "--gui"
        ]
    ],
    "persist": [
        "data.json",
        "keymaps",
        "sounds"
    ],
    "shortcuts": [
        [
            "run_main_window.exe",
            "VeTube"
        ]
    ],
    "checkver": {
        "github": "https://github.com/metalalchemist/VeTube"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/metalalchemist/VeTube/releases/download/v$version/VeTube-x64.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
